# fastapi_server.py
from fastapi import FastAPI, Request
from pydantic import BaseModel
import openai
from weaviate_client import get_weaviate_client
from embedding_util import generate_embeddings
import uvicorn
import logging
from query_classifier import QueryClassifier
import logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)
# Initialize the FastAPI app
app = FastAPI()

# OpenAI API key setup (Replace with your OpenAI key)
openai.api_key = 'sk-nRihvOmpF72sK7WZmNQxiqTwMWpx8YuWIElBpSqBAST3BlbkFJeWPOonQdlVP8Nu_EH3NGxohV-Fs5TfilVY1ILJP2gA'

# Define the input schema
class QueryRequest(BaseModel):
    query: str

# FastAPI endpoint for handling the query
@app.post("/query")
async def handle_query(request: QueryRequest):
    logger.info(f"Received data: {request.query}")
    query = request.query
    print(query)    
    # Generate the embedding for the query
    query_vector = generate_embeddings(query)

    # Get the Weaviate client
    client = get_weaviate_client()

    # Perform the search based on the query vector
    result = client.query.get(
        "DocumentFinance", ["source_text"]
    ).with_near_vector(
        {
            "vector": query_vector,
            "certainty": 0.7  # Adjust the certainty threshold as needed
        }
    ).with_limit(5).with_additional(['certainty', 'distance']).do()

    # Extract the top chunks (source_text)
    chunks = result.get('data', {}).get('Get', {}).get('DocumentFinance', [])
    

    # Call OpenAI GPT-3.5 with the prompt
    classifier = QueryClassifier()
    result = classifier.classify_query(query)
    
    isLongAnswer = result['requires_long_answer']
    if(isLongAnswer):
        prompt = f"User Query: {query}\n\nBased on the following information, please provide a detailed response **only using the provided text**:\n\n"
    else:
        prompt = f"User Query: {query}\n\nBased on the following information, please provide a short and precise information  **only using the provided text**:\n\n"
    
    for idx, chunk in enumerate(chunks):
        prompt += f"Chunk {idx + 1}: {chunk['source_text']}\n\n"

    try:
        response = openai.ChatCompletion.create(
            model="gpt-3.5-turbo",  # Choose the model
            messages=[{"role": "user", "content": prompt}],
            temperature=0.5,
            top_p=0.9,
            max_tokens=200
        )
        gpt_response = response.choices[0].message['content']

        # Return the GPT response as JSON
        return {"response": gpt_response}

    except Exception as e:
        return {"error": str(e)}

# Run the FastAPI app
if __name__ == "__main__":
    uvicorn.run(app, host="0.0.0.0", port=8000)

